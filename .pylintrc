[MASTER]
ignore=tests
persistent=yes
jobs=0

[DESIGN]
max-args=15
max-locals=50
max-branches=25
max-statements=100
max-returns=10

[FORMAT]
max-line-length=140

[BASIC]
good-names=i,j,k,x,y,z,dx,dy,dz,X,Y,Z
argument-naming-style=any
variable-naming-style=any
function-naming-style=any
method-naming-style=any
class-naming-style=any

[MESSAGES CONTROL]
disable=
    C0301,  ; line too long
    C0302,  ; too many lines in module
    C0103,  ; invalid-name
    C0114, C0116,  ; missing docstring
    C0415, C0413, C0411, C0412,  ; import order / location
    R0911, R0912, R0915, R0917,  ; complexity
    R0801,  ; duplicate code
    W1309,  ; f-string without interpolation
    W0612, W0613,
    W1514,
    C0200, C0206,
    R1705, R1720

[TYPECHECK]
ignored-modules=gmsh
